# Port the Express + Socket.IO server listens on
PORT=5000

# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/codesync
# Atlas:          mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/codesync
MONGODB_URI=mongodb://127.0.0.1:27017/codesync

# Comma-separated list of origins allowed to call the API / open a socket.
# Vite's dev server runs on 5173 by default.
CLIENT_ORIGIN=http://localhost:5173

# Public Piston instance used by the "Run" button.
PISTON_API_URL=https://emkc.org/api/v2/piston/execute

# ---------------------------------------------------------------------------
# Code execution mode: "piston" (default) or "local".
#
# "local" runs submitted code with the compilers/interpreters installed on this
# machine. It needs no network and no Piston whitelisting, but there is NO
# SANDBOX — code runs as whoever owns the server process.
#
#   Use it for local development on your own machine.
#   NEVER set it on a deployed or shared server: anyone with a room ID would
#   get arbitrary code execution on that host.
# ---------------------------------------------------------------------------
EXECUTION_MODE=piston

# Interpreter name for Python in local mode (Windows usually "python").
PYTHON_BIN=python

# Safety limits for local mode.
LOCAL_COMPILE_TIMEOUT_MS=20000
LOCAL_RUN_TIMEOUT_MS=10000
LOCAL_MAX_OUTPUT_BYTES=64000
